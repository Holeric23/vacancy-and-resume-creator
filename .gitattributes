# Автоопределение текстовых файлов и принудительное приведение концов строк к LF (стандарт Linux/Docker)
* text=auto

# Явное указание типов файлов для корректной работы git diff и окончаний строк
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.module.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.Dockerfile text eol=lf
*.conf text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Бинарные файлы (картинки, шрифты)
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.svg text
*.woff filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text